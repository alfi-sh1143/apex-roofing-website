rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Global Safety Net: Default-deny catch-all
    match /{document=**} {
      allow read, write: if false;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isValidTrial(data) {
      return data.keys().hasAll(['fullName', 'email', 'companyName', 'teamSize']) &&
        data.fullName is string && data.fullName.size() >= 2 && data.fullName.size() <= 100 &&
        data.email is string && data.email.size() >= 5 && data.email.size() <= 120 &&
        data.companyName is string && data.companyName.size() <= 120 &&
        data.teamSize is string && data.teamSize.size() <= 50;
    }

    function isValidInquiry(data) {
      return data.keys().hasAll(['fullName', 'email', 'message']) &&
        data.fullName is string && data.fullName.size() >= 2 && data.fullName.size() <= 100 &&
        data.email is string && data.email.size() >= 5 && data.email.size() <= 120 &&
        data.message is string && data.message.size() <= 2500;
    }

    match /trial_leads/{leadId} {
      allow create: if isValidId(leadId) && isValidTrial(request.resource.data);
      allow read, list: if isSignedIn();
      allow update, delete: if isSignedIn();
    }

    match /contact_inquiries/{inquiryId} {
      allow create: if isValidId(inquiryId) && isValidInquiry(request.resource.data);
      allow read, list: if isSignedIn();
      allow update, delete: if isSignedIn();
    }
  }
}

